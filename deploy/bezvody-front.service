[Unit]
Description=Платформа «Без Воды» — фронтенд (TanStack Start, SSR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bezvody
Group=bezvody
WorkingDirectory=/opt/bezvody-front
# Сборка nitro самодостаточна: зависимости уже внутри бандла, node_modules на
# сервере не нужен. Поэтому запускаем прямо server/index.mjs.
ExecStart=/usr/bin/node /opt/bezvody-front/server/index.mjs
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Справочник участников лежит ВНЕ /opt/bezvody-front: деплой перезаписывает
# папку приложения целиком с --delete, и данные внутри неё не пережили бы
# ни одной выкатки.
Environment=BV_DATA_DIR=/opt/bezvody-front-data
# Наружу порт не выставляем: снаружи только nginx (8093), сюда он ходит по петле.
Environment=HOST=127.0.0.1
Environment=PORT=5050
# Сколько разговоров с моделью идёт одновременно. Остальные ждут в очереди:
# при тридцати работающих разом модель отвечает «слишком часто», и человек
# видит ошибку вместо разбора. Меняется здесь, без пересборки приложения.
Environment=BV_MODEL_CONCURRENCY=8
# Сколько документов разбирается одновременно: это работа памятью, не сетью.
Environment=BV_FILE_CONCURRENCY=3
# Открытых файлов под нагрузкой нужно больше, чем даёт значение по умолчанию.
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
